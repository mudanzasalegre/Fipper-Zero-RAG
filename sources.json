    {
      "id": "firmware-oficial",
      "url": "https://github.com/flipperdevices/flipperzero-firmware.git",
      "branch": "dev",
      "tier": "official",
      "category": "firmware",
      "max_files": 2800,
      "paths": [
        "ReadMe.md",
        "documentation/**/*.md",
        "documentation/**/*.rst",
        "applications/**/*.md",
        "applications_user/**/*.md",
        "lib/**/*.md",
        "furi/**/*.md",
        "targets/**/*.md",
        "**/*.fam",
        "**/application.fam",
        "**/*.proto",
        "**/*.md",
        "**/*.rst"
      ],
      "code_paths": [
        "furi/**/*.h",
        "furi/**/*.c",
        "applications/**/*.c",
        "applications/**/*.h",
        "applications_user/**/*.c",
        "applications_user/**/*.h",
        "lib/**/*.h",
        "targets/f7/**/*.h",
        "lib/**/*.proto",
        "applications/**/*.js",
        "applications/**/*.py",
        "applications/**/*.cpp",
        "applications/**/*.hpp",
        "lib/**/*.c",
        "lib/**/*.cpp",
        "lib/**/*.h",
        "targets/f7/**/*.c",
        "targets/f7/**/*.h",
