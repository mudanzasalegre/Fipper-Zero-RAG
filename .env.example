# Copy to .env. Python CLI uses environment variables (source .env in shell or use Docker Compose).
RAG_DB_PATH=./data/flipper_rag.sqlite3
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_CHAT_MODEL=qwen2.5:7b
RAG_EMBED_MODEL=nomic-embed-text
# ollama | openai | none
RAG_EMBED_PROVIDER=ollama
RAG_CHAT_PROVIDER=ollama
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=12000
# Alternative OpenAI-compatible endpoints for chat AND/OR embeddings (llama.cpp, vLLM, LM Studio):
# RAG_CHAT_PROVIDER=openai
# RAG_EMBED_PROVIDER=openai # only when the server exposes /v1/embeddings
# RAG_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# RAG_OPENAI_MODEL=local-model
# RAG_OPENAI_API_KEY=local
