  "families": {
    "nfc": {
      "label": "NFC de alta frecuencia",
      "medium": "inductive-hf",
      "evidence": {
        "reference": "https://docs.flipper.net/zero/development/hardware/tech-specs",
        "scope": "family",
        "note": "NFC: familia de 13,56 MHz y transceptor ST25R3916; no certifica cada operación de cada tarjeta"
      },
      "format": ".nfc",
      "frequency_hz": 13560000
    },
    "lf-rfid": {
      "label": "RFID LF 125 kHz",
      "medium": "inductive-lf",
      "evidence": {
        "reference": "https://docs.flipper.net/zero/rfid/read",
        "scope": "family",
        "note": "Familia RFID de 125 kHz; los formatos y las capacidades varían según la tarjeta"
      },
      "format": ".rfid",
      "frequency_hz": 125000
    },
    "sub-ghz": {
      "label": "Radio Sub-GHz",
      "medium": "radio-subghz",
      "evidence": {
        "reference": "https://docs.flipper.net/zero/sub-ghz",
        "scope": "family",
        "note": "Radio del dispositivo entre 300 y 928 MHz; frecuencias TX dependen de la región y los protocolos no son universales"
      },
      "format": ".sub",
      "frequency_range_hz": [
        300000000,
        928000000
      ]
    },
    "infrared": {
      "label": "Infrarrojos",
      "medium": "infrared-optical",
      "evidence": {
        "reference": "https://developer.flipper.net/flipperzero/doxygen/infrared_file_format.html",
        "scope": "family",
        "note": "Mandos IR con variantes parsed y raw; frecuencia de portadora depende del formato y la señal"
      },
      "format": ".ir"
    },
    "ibutton": {
      "label": "Llaves de contacto iButton",
      "medium": "contact-key",
      "evidence": {
        "reference": "https://developer.flipper.net/flipperzero/doxygen/ibutton_file_format.html",
        "scope": "family",
        "note": "Formatos Dallas, Cyfral y Metakom; no todos los tipos son equivalentes a 1-Wire"
      },
      "format": ".ibtn"
    },
    "gpio": {
      "label": "Interfaces GPIO",
      "medium": "wired-digital",
      "evidence": {
        "reference": "https://docs.flipper.net/zero/gpio-and-modules",
        "scope": "family",
        "note": "Los pines GPIO permiten buses y UART con límites eléctricos; la implementación depende del periférico"
